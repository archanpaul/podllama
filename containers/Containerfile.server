# Multi-stage Vulkan GPU-accelerated Qwen Model Server
# Stage 1: Build dependencies (RPM package layer - cached)
FROM registry.fedoraproject.org/fedora-minimal:latest AS builder_deps

RUN microdnf update -y && \
    microdnf install -y --setopt=install_weak_deps=0 \
    cmake \
    gcc-c++ \
    git \
    vulkan-headers \
    vulkan-loader-devel \
    glslc \
    spirv-headers-devel \
    spirv-tools-devel && \
    microdnf clean all

# Stage 2: Compile llama-server with Vulkan GPU support (cached compilation layer)
FROM builder_deps AS builder

ARG LLAMA_CPP_TAG="b6153"

WORKDIR /build
RUN if [ -n "${LLAMA_CPP_TAG}" ]; then \
        echo "Cloning llama.cpp pinned release: ${LLAMA_CPP_TAG}"; \
        git clone --depth 1 --branch "${LLAMA_CPP_TAG}" https://github.com/ggerganov/llama.cpp.git .; \
    else \
        echo "Cloning llama.cpp latest main branch..."; \
        git clone --depth 1 https://github.com/ggerganov/llama.cpp.git .; \
    fi && \
    cmake -B build -DGGML_VULKAN=ON -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build --config Release -j$(nproc) --target llama-server

# Stage 3: Runtime dependencies (RPM package layer - cached)
FROM registry.fedoraproject.org/fedora-minimal:latest AS runtime_deps

RUN microdnf update -y && \
    microdnf install -y --setopt=install_weak_deps=0 \
    libgomp \
    mesa-vulkan-drivers \
    vulkan-loader \
    vulkan-tools \
    libstdc++ \
    python3 \
    python3-pyyaml \
    curl \
    jq \
    ca-certificates && \
    microdnf clean all

# Stage 4: Final runner image
FROM runtime_deps AS runner

COPY --from=builder /build/build/bin/ /usr/bin/
ENV LD_LIBRARY_PATH=/usr/bin:$LD_LIBRARY_PATH

WORKDIR /app
COPY config/model_conf.yaml /app/config/model_conf.yaml
COPY containers/entrypoint-server.sh /app/entrypoint-server.sh
RUN chmod +x /app/entrypoint-server.sh /usr/bin/llama-server

EXPOSE 8080
VOLUME ["/models"]

ENTRYPOINT ["/app/entrypoint-server.sh"]
