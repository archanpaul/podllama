# Qwen Model Server Container using Fedora 44 Minimal & Prebuilt RPM Packages
FROM registry.fedoraproject.org/fedora-minimal:44

RUN microdnf update -y && \
    microdnf install -y --setopt=install_weak_deps=0 \
        llama-cpp \
        mesa-vulkan-drivers \
        vulkan-loader \
        vulkan-tools \
        python3 \
        python3-pyyaml \
        curl \
        jq \
        ca-certificates && \
    microdnf clean all

# Set up application and model directories
WORKDIR /app
COPY config/model_conf.yaml /app/config/model_conf.yaml
COPY containers/entrypoint-server.sh /app/entrypoint-server.sh
RUN chmod +x /app/entrypoint-server.sh

# Expose model server port
EXPOSE 8080
VOLUME ["/models"]

ENTRYPOINT ["/app/entrypoint-server.sh"]



