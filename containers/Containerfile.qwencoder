# Qwen Code Workspace Agent Container using Official QwenLM/qwen-code
FROM registry.fedoraproject.org/fedora-minimal:44

ARG QWEN_CODE_VERSION=""

RUN microdnf update -y && \
    microdnf install -y --setopt=install_weak_deps=0 \
        python3 \
        python3-requests \
        python3-urllib3 \
        curl \
        git \
        tar \
        gzip \
        ca-certificates && \
    microdnf clean all

# Download and install official QwenLM/qwen-code binary (latest release or specified build arg)
RUN if [ -n "${QWEN_CODE_VERSION}" ]; then \
        DOWNLOAD_URL="https://github.com/QwenLM/qwen-code/releases/download/${QWEN_CODE_VERSION}/qwen-code-linux-x64.tar.gz"; \
    else \
        DOWNLOAD_URL="https://github.com/QwenLM/qwen-code/releases/latest/download/qwen-code-linux-x64.tar.gz"; \
    fi && \
    echo "Downloading QwenLM/qwen-code from: ${DOWNLOAD_URL}" && \
    curl -L -o /tmp/qwen-code.tar.gz "${DOWNLOAD_URL}" && \
    mkdir -p /opt && \
    tar -xzf /tmp/qwen-code.tar.gz -C /opt/ && \
    rm -f /tmp/qwen-code.tar.gz && \
    ln -sf /opt/qwen-code/bin/qwen /usr/local/bin/qwen-code && \
    ln -sf /opt/qwen-code/bin/qwen /usr/local/bin/qwen && \
    chmod +x /opt/qwen-code/bin/qwen /usr/local/bin/qwen-code

# Set up application workspace
WORKDIR /app
COPY config/model_conf.yaml /app/config/model_conf.yaml
COPY containers/entrypoint-client.sh /app/entrypoint-client.sh
RUN chmod +x /app/entrypoint-client.sh

# Restricted workspace mount point
WORKDIR /workspace
VOLUME ["/workspace"]

ENTRYPOINT ["/app/entrypoint-client.sh"]
