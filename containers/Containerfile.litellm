# LiteLLM Proxy Server — based on the official prebuilt image
# https://docs.litellm.ai/docs/proxy/deploy
#
# Pin a specific tag for reproducibility; bump as needed.
# Use "latest" only for development.
ARG LITELLM_TAG=latest
FROM ghcr.io/berriai/litellm:${LITELLM_TAG}

# The official image already includes litellm, fastapi, uvicorn, etc.
# We only add our project config and custom entrypoint.

WORKDIR /app
COPY config/litellm_config.yaml /app/config.yaml
COPY containers/entrypoint-litellm.sh /app/entrypoint-litellm.sh
RUN chmod +x /app/entrypoint-litellm.sh

EXPOSE 4000

ENTRYPOINT ["/app/entrypoint-litellm.sh"]
CMD []
