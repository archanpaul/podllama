# Multi-stage LiteLLM Proxy Server (Fedora Minimal)
# Stage 1: Build - install Python build deps, compile wheels, create venv
FROM registry.fedoraproject.org/fedora-minimal:latest AS builder

RUN microdnf update -y && \
    microdnf install -y --setopt=install_weak_deps=0 \
    python3 \
    python3-pip \
    python3-devel \
    gcc \
    gcc-c++ \
    libffi-devel \
    openssl-devel \
    cargo \
    && microdnf clean all

RUN python3 -m venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Pin litellm version for reproducibility; bump as needed
ARG LITELLM_VERSION=""
RUN if [ -n "${LITELLM_VERSION}" ]; then \
        pip install --no-cache-dir "litellm[proxy]==${LITELLM_VERSION}"; \
    else \
        pip install --no-cache-dir "litellm[proxy]"; \
    fi

# Stage 2: Runtime - minimal image with only the venv
FROM registry.fedoraproject.org/fedora-minimal:latest AS runtime

RUN microdnf update -y && \
    microdnf install -y --setopt=install_weak_deps=0 \
    python3 \
    libffi \
    openssl-libs \
    curl \
    ca-certificates \
    && microdnf clean all

# Copy the pre-built venv from the builder stage
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY config/litellm_config.yaml /app/config.yaml
COPY containers/entrypoint-litellm.sh /app/entrypoint-litellm.sh
RUN chmod +x /app/entrypoint-litellm.sh

EXPOSE 4000

ENTRYPOINT ["/app/entrypoint-litellm.sh"]
CMD []

