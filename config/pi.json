        {
          "id": "podllama-thinking",
          "name": "PodLlama Thinking",
          "contextWindow": 16384
        },
        {
          "id": "podllama-instruct",
          "name": "PodLlama Instruct (Qwen 2.5 Coder 7B)",
          "contextWindow": 16384
        }
      ]
    }
  }
}
